# Copie este arquivo para "secrets.toml" (mesma pasta) e preencha os valores.
# O secrets.toml real NÃO deve ser versionado (está no .gitignore).

# --- Supabase (obrigatório) ---------------------------------------------------
# Estas chaves ficam FORA de qualquer [seção] (raiz do TOML).
# URL: encontre em Project Settings → API → "Project URL"
# Service key: Project Settings → API → "service_role" (NÃO use a anon key —
# precisamos gravar nas tabelas/bucket. NUNCA versione esta chave.)
SUPABASE_URL = "https://<projeto>.supabase.co"
SUPABASE_SERVICE_KEY = "eyJhbGciOi..."

# --- Senha de acesso do app ---------------------------------------------------
[app]
senha = "troque-esta-senha"

# --- Apoio de IA (opcional) ---------------------------------------------------
# Gere uma chave GRATUITA do Gemini em: https://aistudio.google.com/app/apikey
# Sem esta seção, o app funciona normalmente — só os botões de IA ficam inativos.
[ia]
provedor = "gemini"
api_key  = "COLE_AQUI_SUA_CHAVE_DO_GEMINI"
modelo   = "gemini-2.5-flash"   # opcional
